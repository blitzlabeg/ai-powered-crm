# =============================================================================
# ai-powered-crm environment configuration
# Copy this file to ".env" and fill in the values below.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=ai-powered-crm
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Auto-reload the server on code changes (development only)
APP_RELOAD=true
# A random secret used to sign session data. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, zero setup, great for local development):
DATABASE_URL=sqlite:///./data/ai_powered_crm.db
#
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg2://crm_user:crm_password@localhost:5432/ai_crm

# ---------------------------------------------------------------------------
# OpenAI (used for AI Features: summaries, email drafting, insights, etc.)
# ---------------------------------------------------------------------------
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Model used for the OpenAI Responses API
OPENAI_MODEL=gpt-4o-mini
# Max output tokens for AI-generated content
OPENAI_MAX_OUTPUT_TOKENS=800
